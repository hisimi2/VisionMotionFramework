#pragma once

#include <functional> // boost::function 대신 C++ 표준 라이브러리 사용

namespace VisionCom
{
    using SchedulerTask = std::function<void()>;

    class IScheduler 
    {
    public:
        virtual ~IScheduler() = default;

        virtual void Schedule(const SchedulerTask& task, int delayMs = 0) = 0;

        virtual void Start() = 0;
        virtual void Stop() = 0;
    };

} // namespace VisionCom
