<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <!-- 패키지 식별자 (v140 = VS2015/2019/2026) -->
    <id>VisionMotionFramework.Core.v140</id>
    <version>1.0.0</version>
    <title>VisionMotionFramework Core (v140)</title>
    <authors>VisionMotionFramework Team</authors>
    <owners>VisionMotionFramework</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>
      VisionMotionFramework Core Engine - 시퀀스 기반 Vision 검사 프레임워크.
      v140 (VS2015/2019/2026)용 DLL + 헤더입니다.

      포함 항목:
      - VisionMotionFramework.dll (Core 엔진 DLL)
      - VisionComm.dll (통신 DLL)
      - NonBlockingTaskBase (비동기 Task 기초 클래스)
      - SequenceBuilderBase (시퀀스 조립 팩토리)
      - ComponentSetupBase (컴포넌트 설정 기본 클래스)
      - DefaultSetupStrategy (기본 Setup 전략)
      - CMockDataRepository, CMockVisionEventHandler (Mock 객체)
      - IDataRepository, IVisionProcessor, IActuator 등 인터페이스
      - Context, Sequence, Types 등 핵심 타입
    </description>
    <summary>VisionMotionFramework Core Engine - v140 (VS2015/2019/2026)</summary>
    <releaseNotes>최초 릴리스. C++14 표준, 동적 CRT (/MD), MFC Dynamic</releaseNotes>
    <copyright>Copyright (c) 2026 VisionMotionFramework Team</copyright>
    <language>ko-KR</language>
    <tags>VisionMotionFramework VMF Vision Sequence StateMachine C++ native</tags>
    <projectUrl>https://github.com/hisimi2/VisionMotionFramework</projectUrl>

    <!-- 네이티브 패키지임을 명시 -->
    <packageTypes>
      <packageType name="native" />
    </packageTypes>

    <!-- 
      VC++ Runtime 의존성:
      사용자 시스템에 VC++ 2015-2022 Redistributable이 설치되어 있어야 합니다.
      (vcruntime140.dll, mfc140u.dll, msvcp140.dll)
    -->
  </metadata>

  <files>
    <!-- ================================================================ -->
    <!-- MSBuild props (NuGet 자동 import - include/lib 경로 설정) -->
    <!-- ================================================================ -->
    <file src="build\native\VisionMotionFramework.Core.v140.props"
          target="build\native\VisionMotionFramework.Core.v140.props" />

    <!-- ================================================================ -->
    <!-- MSBuild targets (NuGet 자동 import - DLL 복사) -->
    <!-- ================================================================ -->
    <file src="build\native\VisionMotionFramework.Core.v140.targets"
          target="build\native\VisionMotionFramework.Core.v140.targets" />

    <!-- ================================================================ -->
    <!-- DLL + import lib - Win32 Debug -->
    <!-- ================================================================ -->
    <file src="..\bin\Win32\Debug\VisionMotionFramework.dll"
          target="build\native\bin\Win32\Debug\VisionMotionFramework.dll" />
    <file src="..\bin\Win32\Debug\VisionMotionFramework.lib"
          target="build\native\bin\Win32\Debug\VisionMotionFramework.lib" />
    <file src="..\bin\Win32\Debug\VisionComm.dll"
          target="build\native\bin\Win32\Debug\VisionComm.dll" />
    <file src="..\bin\Win32\Debug\VisionComm.lib"
          target="build\native\bin\Win32\Debug\VisionComm.lib" />

    <!-- ================================================================ -->
    <!-- DLL + import lib - Win32 Release -->
    <!-- ================================================================ -->
    <file src="..\bin\Win32\Release\VisionMotionFramework.dll"
          target="build\native\bin\Win32\Release\VisionMotionFramework.dll" />
    <file src="..\bin\Win32\Release\VisionMotionFramework.lib"
          target="build\native\bin\Win32\Release\VisionMotionFramework.lib" />
    <file src="..\bin\Win32\Release\VisionComm.dll"
          target="build\native\bin\Win32\Release\VisionComm.dll" />
    <file src="..\bin\Win32\Release\VisionComm.lib"
          target="build\native\bin\Win32\Release\VisionComm.lib" />

    <!-- ================================================================ -->
    <!-- 헤더 파일 (include) -->
    <!-- ================================================================ -->
    <file src="..\VisionMotionFramework\include\*.h"
          target="build\native\include\" />

    <!-- Mock 헤더 (build\native\include\Mock\ 에 위치) -->
    <file src="..\VisionMotionFramework\include\Mock\*.h"
          target="build\native\include\Mock\" />

    <!-- VisionComm 헤더 (VC namespace) -->
    <file src="..\VisionComm\include\*.h"
          target="build\native\include\VC\" />
  </files>
</package>

